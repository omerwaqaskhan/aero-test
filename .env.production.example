# LuftWay Production Environment Variables
# Copy this file to .env.production and fill in all values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=luftway_prod
POSTGRES_USER=luftway_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://luftway_user:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/luftway_prod

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD_HERE@redis:6379/0

# ============================================
# JWT SECURITY (CRITICAL - Generate strong keys)
# ============================================
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_KEY_USING_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# EMAIL CONFIGURATION (Required for production)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_USE_TLS=true
EMAIL_FROM=noreply@luftway.com
EMAIL_FROM_NAME=LuftWay

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=https://www.luftway.com/api

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# OPTIONAL: SMS CONFIGURATION (Twilio)
# ============================================
# SMS_PROVIDER=twilio
# SMS_API_KEY=your-twilio-account-sid
# SMS_API_SECRET=your-twilio-auth-token

# ============================================
# OPTIONAL: OAUTH CONFIGURATION
# ============================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ============================================
# OPTIONAL: MONITORING & ALERTING
# ============================================
# ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts
# ALERT_EMAIL_ENABLED=false

# ============================================
# OPTIONAL: SCRAPER PROXIES
# ============================================
# SCRAPER_PROXIES=http://proxy1:port,http://proxy2:port
